# Capsule Cloud API — environment variables
# Copy this file to .env and fill in your values.

# Legend: [REQUIRED] must be set to run in production · [OPTIONAL] has a safe default.

# ── App ──────────────────────────────────────────────────────
# [OPTIONAL] "development" (default) or "production". Production enforces a real
# JWT keypair and disables dev conveniences.
ENVIRONMENT=development
# [OPTIONAL] Verbose SQL/logging. Keep false in production.
DEBUG=false

# [REQUIRED in production] Used for non-JWT HMAC (signed URLs etc.), NOT for JWT.
# Generate with:  openssl rand -hex 32
SECRET_KEY=change-me-use-32-random-bytes

# ── Database ─────────────────────────────────────────────────
# [REQUIRED] Connection string for the app's own Postgres (all user data lives here).
# Local dev (SQLite, auto-created) — fine to leave as-is locally:
DATABASE_URL=sqlite+aiosqlite:///./capsule_cloud.db
# Production: on Railway set this to a Reference → Postgres DATABASE_URL
#   (resolves to ${{Postgres.DATABASE_URL}}). The validator auto-upgrades
#   postgresql:// → postgresql+asyncpg://
# DATABASE_URL=postgresql://user:password@host:5432/capsule_cloud

# ── JWT — EdDSA Ed25519 keypair ───────────────────────────────
# [REQUIRED in production] Left blank = ephemeral keys auto-generated in dev
# (all tokens invalidated on restart in dev mode — that is fine).
# Where to get them: generate locally with the command below; the keys are
# yours (no third party). Paste each as a single line using \n for newlines.
#
# Generate once with:
#   python -c "
#   from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
#   from cryptography.hazmat.primitives.serialization import Encoding, PrivateFormat, PublicFormat, NoEncryption
#   k = Ed25519PrivateKey.generate()
#   print('JWT_PRIVATE_KEY=' + k.private_bytes(Encoding.PEM, PrivateFormat.PKCS8, NoEncryption()).decode().replace(chr(10), r'\n'))
#   print('JWT_PUBLIC_KEY='  + k.public_key().public_bytes(Encoding.PEM, PublicFormat.SubjectPublicKeyInfo).decode().replace(chr(10), r'\n'))
#   "
# Use \n (backslash-n) for newlines in env var values (Railway handles this fine).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# [OPTIONAL] Token lifetimes (sensible defaults shown).
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Object Storage — Backblaze B2 (S3-compatible) ────────────
# [REQUIRED in production] Durable storage for uploaded .capsule files.
# Leave blank in local dev — falls back to data/storage/ on disk.
# Where to get them: Backblaze B2 → Buckets → Application Keys. The
# STORAGE_ENDPOINT region must match your bucket, e.g.:
#   https://s3.us-west-004.backblazeb2.com
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# [OPTIONAL] Bucket name (default: capsule-sessions). Must exist in your B2 account.
STORAGE_BUCKET=capsule-sessions

# ── Modal cloud replay ────────────────────────────────────────
# [OPTIONAL] Enables remote replay execution. Where to get them:
#   https://modal.com/settings/tokens
# Leave blank in dev/prod — replay returns status "pending_modal_config" (no crash).
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ── CORS ──────────────────────────────────────────────────────
# [OPTIONAL] Comma-separated origins (or a JSON array) allowed to call the API.
# Defaults cover localhost + *.vercel.app + *.railway.app. Set to your exact
# production frontend origin to lock it down, e.g.:
#   ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000
