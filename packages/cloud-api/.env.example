# Capsule Cloud API — environment variables
# Copy this file to .env and fill in your values.

# App
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-me-use-32-random-bytes

# Database
# SQLite (dev/local):
DATABASE_URL=sqlite+aiosqlite:///./capsule_cloud.db
# PostgreSQL (Railway / production) — the app auto-fixes postgresql:// → postgresql+asyncpg://
# DATABASE_URL=postgresql://user:password@host:5432/capsule_cloud

# CORS — comma-separated list of allowed frontend origins
# ALLOWED_ORIGINS=["http://localhost:3000","https://your-app.vercel.app"]

# Object storage (Cloudflare R2 / S3-compatible) — leave empty to use local disk in dev
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=capsule-sessions

# JWT settings
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
